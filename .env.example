# 팀 전체가 같은 상태를 보려면 아래 Redis REST 정보가 필요합니다.
# Vercel → Storage → Upstash Redis(무료)를 연결하면 자동으로 채워집니다.
# (Upstash 콘솔에서 직접 복사해도 됩니다. 둘 중 아무 이름이나 인식합니다.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV / 통합 마켓플레이스에서 연결하면 이 이름으로 들어옵니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 선택 사항: Microsoft Teams 로 "도착했어요"를 등록하면 자동으로 알림을 보냅니다.
# 1) 채널(팀) 웹훅 — Teams 채널 → ⋯ → Workflows 로 만든 주소
TEAMS_WEBHOOK_URL=

# 2) 채팅(개인·그룹 채팅) 웹훅 — 채팅에서 만든 주소. 둘 다 넣으면 양쪽에 동시에 갑니다.
#    한 변수에 콤마(,)로 여러 주소를 넣어도 됩니다. (중복 주소는 한 번만 전송)
TEAMS_WEBHOOK_CHAT_URL=

# 선택 사항: 링크 미리보기·Teams 알림 버튼에 쓸 대표 주소 (예: https://snack-alert.vercel.app)
# 비워두면 Vercel 이 자동으로 넣어주는 주소(VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL)를 씁니다.
NEXT_PUBLIC_SITE_URL=

# 선택 사항: 휴대폰 알림(Web Push) — 앱을 닫아도 “도착했어요” 순간 알림이 갑니다.
# 키 만들기: npx web-push generate-vapid-keys --json
# 두 값이 비어 있으면 사이트·API 는 그대로 동작하고 휴대폰 알림만 건너뜀니다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 비워두면 mailto:snack-alert@example.com
VAPID_SUBJECT=
